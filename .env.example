PUBLIC_SHOPIFY_SHOP={your-store}.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PRIVATE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cloudinary (image hosting)
PUBLIC_CLOUDINARY_CLOUD_NAME=southland-organics
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# point.dog pixel — keep brandId=southland so JockShock events land in the
# Southland CDP namespace (JockShock is a Southland sub-brand). Sub-brand
# tagging happens at event time via defaultProperties.sub_brand=jockshock
# in BaseLayout.astro.
PUBLIC_PIXEL_BRAND_ID=southland
PUBLIC_PIXEL_ENDPOINT=https://pixel.southlandorganics.com/collect

# SendGrid — powers /api/teams-intake (Carmen B2B form). Same Southland
# account as southland-platform; safe to share since JockShock is a
# Southland sub-brand.
SENDGRID_API_KEY=

# Customer.io — powers /api/lead-magnet (Gear Smell Field Guide footer form
# + bottle-label QR) and /api/cart-event (server-side bridge that fires
# viewed_product / added_to_cart / viewed_cart / started_checkout when the
# sl_email cookie is set).
#
# These are the TRACK credentials (Basic auth against track.customer.io), NOT
# the App API bearer key — the App key cannot identify or track.
#
# JockShock shares the SOUTHLAND workspace: it is a sub-brand, not a separate
# account, so this is the same site id / track key Nexus uses. Every JockShock
# segment MUST filter on the `sub_brand = jockshock` attribute, or a JockShock
# send goes to the entire Southland book.
#
# Required for prod. Replaced Klaviyo 2026-08-11 (Nexus T-1175).
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=