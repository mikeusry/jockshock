    margin-bottom: 16px;
  }
  .section-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #fff;
    margin: 0 0 16px;
    line-height: 1.15;
  }
  .section-headline.center { text-align: center; }
  .section-sub {
    font-size: 1.125rem;
    color: var(--jockshock-muted);
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 720px;
  }
  .section-sub.center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  /* === HERO ===
     Gear, not face. He's in a polo in an office — the authority on this page
     is the b-roll. */
