    padding: 18px 36px;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.9375rem;
    border-radius: 4px;
    transition: transform 0.1s ease, box-shadow 0.15s ease;
  }
