    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .hero-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .hero-copy { max-width: 640px; }
  .hero-headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    color: #fff;
    line-height: 1.1;
    margin: 0 0 16px;
  }
