---
/**
 * /gyms — gyms, academies, wrestling rooms, training floors. Paid lander. Simplifi only after this
 * page is honest. Search is out of this plan.
 *
 * One program: spray ZeroPoint on the floor, sell JockShock to the roster,
 * keep the margin. Quotes go to Mike, Philip, and Brad. Fred is off this page.
 *
 * 🛑 TWO CLAIMS REGISTERS. JockShock never "disinfects." ZeroPoint never
 *    "kills the funk." Do not merge the cards.
 *
 * 🛑 No invented testimonial. SPG has samples, not a purchase. Do not use
 *    Life Change Fitness as a named success story. gymLifeChange stays off
 *    this page until a claims-safe transcript exists.
 *
 * 🛑 ZeroPoint is quote-only. No add-to-cart.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import MuxVideo from "../components/MuxVideo.astro";
import { VIDEOS } from "../data/videos";

const title = "JockShock for Gyms — One Program";
const description =
  "Those mats are the most expensive thing you own. One program: spray ZeroPoint on the floor, sell JockShock to the roster, keep the margin.";

const CLD = "https://res.cloudinary.com/southland-organics/image/upload";
const BOTTLE_SINGLE = `${CLD}/c_fit,w_560,q_auto,f_auto,dpr_auto/JockShock/jockshock-32oz-single-2026.png`;
const BOTTLE_3PACK = `${CLD}/c_fit,w_560,q_auto,f_auto,dpr_auto/JockShock/jockshock-3pack-athlete-2026.png`;
const BOTTLE_6PACK = `${CLD}/c_fit,w_560,q_auto,f_auto,dpr_auto/JockShock/jockshock-6pack-team-2026.png`;
const ZP_CASE = `${CLD}/c_fit,w_560,q_auto,f_auto,dpr_auto/Southland%20Website/products/zeropoint-industrial/ZeroPoint-2x2.5G-Case`;

const PDP = "/products/jockshock/?utm_campaign=js-gyms";
const BROLL = VIDEOS.gymBroll;
---

<BaseLayout title={title} description={description}>
  <div class="js-gyms">
    <!-- HERO — the job. Headline does the job. Subhead does the program. -->
    <section class="hero" id="top">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">For the person who runs the room</p>
          <h1 class="hero-headline">
            Those mats are the most expensive thing you own.
          </h1>
          <p class="hero-sub">
            One program. Spray ZeroPoint on the floor. Sell JockShock to the roster. Keep the margin.
          </p>
          <p class="hero-promise">
            You already spray something. Alcohol and ammonia dry the surface.
            People trust this room. The job is keep it clean without wrecking
            the floor — and stop buying random bottles that do one half of the work.
          </p>
          <div class="hero-cta-row">
            <a href="#program-ask" class="cta-primary">Get the program</a>
            <a href="#show" class="cta-secondary">See it in a gym</a>
          </div>
          <ul class="hero-trust">
            <li>You spray the room</li>
            <li>You sell the bottle that goes home</li>
            <li>No contract</li>
            <li>Made in USA</li>
          </ul>
        </div>
        <div class="hero-bottles">
          <figure class="hero-bottle">
            <img src={ZP_CASE} alt="ZeroPoint 2.5-gallon case — the facility bottle" width="560" height="840" />
            <figcaption>Stays in the closet</figcaption>
          </figure>
          <figure class="hero-bottle">
            <img src={BOTTLE_SINGLE} alt="JockShock 32oz — the athlete bottle" width="560" height="840" />
            <figcaption>Sells at the desk</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ONE PROGRAM -->
    <section class="program" id="program">
      <div class="program-inner">
        <p class="section-eyebrow">One program</p>
        <h2 class="section-headline">You spray one. You sell the other.</h2>
        <p class="section-sub">
          ZeroPoint stays in the closet — floors, mats, iron, shared surfaces.
          JockShock sells at the desk — the bottle that goes home in the bag.
          Same chemistry family. Two labels. One conversation.
        </p>
        <blockquote class="pull">
          <p>You keep the margin on the bottle the roster takes home.</p>
          <cite>No fake wholesale sheet. We quote the room, then the desk.</cite>
        </blockquote>
      </div>
    </section>

    <!-- SHOW IT — real gym B-roll + both bottles. Not an interview. -->
    <section class="show" id="show">
      <div class="show-inner">
        <p class="section-eyebrow">In the room</p>
        <h2 class="section-headline center">This is us spraying a gym.</h2>
        <div class="show-video">
          <MuxVideo
            playbackId={BROLL.playbackId}
            title={BROLL.title}
            aspect={BROLL.aspect}
            posterTime={BROLL.posterTime}
          />
        </div>
        <p class="video-caption">
          Handheld sprayer on iron and bags. No stock mat. No invented interview.
        </p>
        <div class="bottle-pair">
          <figure>
            <img src={ZP_CASE} alt="ZeroPoint case — facility disinfectant" width="560" height="840" loading="lazy" />
            <figcaption>ZeroPoint — the room</figcaption>
          </figure>
          <figure>
            <img src={BOTTLE_SINGLE} alt="JockShock 32oz — athlete deodorizer" width="560" height="840" loading="lazy" />
            <figcaption>JockShock — the roster</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- FACILITY — ZeroPoint. Disinfectant language lives ONLY here. -->
    <section class="how" id="facility">
      <div class="how-inner">
        <p class="section-eyebrow">The facility</p>
        <h2 class="section-headline">The mats stay wet for ten minutes. That's the job.</h2>
        <p class="section-sub">
          ZeroPoint is an EPA-registered disinfectant (Reg. No. 97801-1-102456).
          Hospital disinfectant / broad spectrum — on the organisms on the
          label, at a 10-minute wet dwell:
        </p>
        <ul class="organism-list">
          <li><em>Staphylococcus aureus</em></li>
          <li><em>Pseudomonas aeruginosa</em></li>
          <li>Human Coronavirus 229E</li>
        </ul>
        <p class="section-sub">
          No alcohol. No ammonia. No fragrance to cover a room that still
          isn't done. Cases, not a spray bottle from the front desk: 4×1-gallon
          or 2×2.5-gallon, sized to the room. We quote it. You don't fight
          a cart.
        </p>
        <a href="#program-ask" class="cta-secondary">Get a facility quote</a>
      </div>
    </section>

    <!-- ATHLETE — JockShock. Odor language lives ONLY here. -->
    <section class="athlete" id="athlete">
      <div class="athlete-inner">
        <p class="section-eyebrow">The athlete</p>
        <h2 class="section-headline">They leave. The bag goes home.</h2>
        <p class="section-sub">
          A mop bucket does not follow them home. JockShock is the bottle
          you sell for that — a pro-grade equipment deodorizer for the gear
          that leaves. Hypochlorous acid — the same molecule your immune
          system makes. Powered by EPA-registered ZeroPoint Technology. Kills
          the funk at the source. Not a perfume. Not a household cleaner
          poured on expensive gear.
        </p>
        <div class="how-grid">
          <div class="how-card">
            <h3>No fragrance</h3>
            <p>Nothing is covered up. No perfume layer waiting to wear off.</p>
          </div>
          <div class="how-card">
            <h3>No bleach</h3>
            <p>Water-based. Built for the materials gear is actually made of.</p>
          </div>
          <div class="how-card">
            <h3>Safe on skin contact</h3>
            <p>Same chemistry family as wound-care saline.</p>
          </div>
          <div class="how-card">
            <h3>Won't wreck tape or polish</h3>
            <p>Alcohol will. This will not. Materials fact — not a kill claim.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROTOCOL -->
    <section class="routine" id="protocol">
      <div class="routine-inner">
        <p class="section-eyebrow">After they leave</p>
        <h2 class="section-headline">Two sprays. Same room.</h2>
        <ol class="steps">
          <li>
            <span class="step-num">1</span>
            <h3>Floors, mats, shared surfaces — ZeroPoint</h3>
            <p>Wet for 10 minutes. That's the label.</p>
          </li>
          <li>
            <span class="step-num">2</span>
            <h3>Gloves, shoes, bag — JockShock</h3>
            <p>Spray. Dry. Goes home.</p>
          </li>
          <li>
            <span class="step-num">3</span>
            <h3>Do not use one bottle for both</h3>
            <p>The athlete spray is not the mop-bucket chemical.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ASK — program first. Athlete buy is the side door. -->
    <section class="doors" id="program-ask">
      <div class="doors-inner">
        <p class="section-eyebrow">The program</p>
        <h2 class="section-headline">Tell us about the room.</h2>
        <p class="section-sub">
          We size ZeroPoint to the mats and put JockShock at the desk.
          Goes to Mike, Philip, and Brad. One business day.
        </p>

        <div class="doors-grid">
          <div class="door door-quote">
            <p class="door-eyebrow">Owner / coach</p>
            <h3>Get the program</h3>
            <p class="door-sub">Cases sized to the room. No cart. No contract.</p>

            <div class="quote-success" data-success hidden>
              <h3>Got it. We'll email you.</h3>
              <p>
                Someone from the team will reply within one business day. If
                you need to chat sooner, call
                <a href="tel:8006083755">800-608-3755</a>.
              </p>
            </div>

            <form class="quote-form" method="POST" action="/api/teams-intake" data-quote-form>
              <div class="form-row">
                <label>
                  <span>Your name</span>
                  <input type="text" name="name" required autocomplete="name" />
                </label>
                <label>
                  <span>Role</span>
                  <select name="role" required>
                    <option value="">Select…</option>
                    <option>Gym owner</option>
                    <option>Head coach</option>
                    <option>Assistant coach</option>
                    <option>Athletic trainer (ATC)</option>
                    <option>Club / program director</option>
                    <option>Other</option>
                  </select>
                </label>
              </div>

              <div class="form-row">
                <label>
                  <span>Gym</span>
                  <input type="text" name="organization" required autocomplete="organization" />
                </label>
                <label>
                  <span>City</span>
                  <input type="text" name="city" required autocomplete="address-level2" />
                </label>
              </div>

              <div class="form-row">
                <label>
                  <span>Email</span>
                  <input type="email" name="email" required autocomplete="email" inputmode="email" />
                </label>
                <label>
                  <span>Phone (optional)</span>
                  <input type="tel" name="phone" autocomplete="tel" inputmode="tel" />
                </label>
              </div>

              <div class="form-row">
                <label>
                  <span>What kind of gym</span>
                  <select name="sport" required>
                    <option value="">Select…</option>
                    <option>Fitness / training</option>
                    <option>Combat / mats</option>
                    <option>Wrestling</option>
                    <option>Boxing</option>
                    <option>Multi-sport / other</option>
                  </select>
                </label>
                <label>
                  <span>People through the door per week</span>
                  <select name="roster_size" required>
                    <option value="">Select…</option>
                    <option>Under 25</option>
                    <option>25–50</option>
                    <option>50–100</option>
                    <option>100–200</option>
                    <option>200+</option>
                  </select>
                </label>
              </div>

              <div class="form-row">
                <label>
                  <span>What do you spray now?</span>
                  <input type="text" name="spray_now" required placeholder="Alcohol, ammonia, Ecolab, nothing…" />
                </label>
                <label>
                  <span>Chemical contract?</span>
                  <select name="under_contract" required>
                    <option value="">Select…</option>
                    <option>No</option>
                    <option>Yes — Ecolab</option>
                    <option>Yes — other</option>
                    <option>Not sure</option>
                  </select>
                </label>
              </div>

              <div class="form-row">
                <label>
                  <span>Decision timeline</span>
                  <select name="timeline" required>
                    <option value="">Select…</option>
                    <option>This week (urgent)</option>
                    <option>This month</option>
                    <option>This quarter</option>
                    <option>Just exploring</option>
                  </select>
                </label>
                <label></label>
              </div>

              <label class="form-fullwidth">
                <span>Anything else (optional)</span>
                <textarea name="notes" rows="3" placeholder="Room size, mat type, how often you mop."></textarea>
              </label>

              <input type="hidden" name="persona" value="carmen" />
              <input type="hidden" name="source" value="jockshock-gyms-page" />

              <button type="submit" class="cta-primary cta-submit">Send the request</button>
              <p class="form-note">
                Goes to Mike, Philip, and Brad. No marketing spam.
              </p>
            </form>
          </div>

          <div class="door door-side">
            <p class="door-eyebrow">Already buying for one bag?</p>
            <h3>JockShock — checkout</h3>
            <p class="door-sub">Side door. Same ladder as the rest of the site. Free shipping on 3+.</p>
            <div class="tier-grid">
              <a href={PDP} class="tier" data-gym-athlete-cta>
                <img class="tier-img" src={BOTTLE_SINGLE} alt="JockShock 32oz single bottle" loading="lazy" />
                <div class="tier-label">One bag</div>
                <div class="tier-detail">1 × 32oz</div>
                <div class="tier-price">$24.99</div>
                <div class="tier-bottom">Get it →</div>
              </a>
              <a href={PDP} class="tier featured" data-gym-athlete-cta>
                <span class="tier-badge">Locker / car / home</span>
                <img class="tier-img" src={BOTTLE_3PACK} alt="JockShock 3-pack" loading="lazy" />
                <div class="tier-label">3-Pack</div>
                <div class="tier-detail">3 × 32oz</div>
                <div class="tier-price">$59.99</div>
                <div class="tier-ship">Free shipping</div>
                <div class="tier-bottom">Get it →</div>
              </a>
              <a href={PDP} class="tier" data-gym-athlete-cta>
                <img class="tier-img" src={BOTTLE_6PACK} alt="JockShock 6-pack" loading="lazy" />
                <div class="tier-label">Class shelf</div>
                <div class="tier-detail">6 × 32oz — still checkout, not the facility quote</div>
                <div class="tier-price">$99.99</div>
                <div class="tier-ship">Free shipping</div>
                <div class="tier-bottom">Get it →</div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq" id="faq">
      <div class="faq-inner">
        <h2 class="section-headline center">Straight answers</h2>
        <div class="faq-grid">
          <details>
            <summary>Will this dry out our mats?</summary>
            <p>
              ZeroPoint is not alcohol and not ammonia. Mat-safe here means
              materials compatibility — it will not dry a mat the way those do.
              It is not a kill-rate claim.
            </p>
          </details>
          <details>
            <summary>We're on Ecolab.</summary>
            <p>
              Then the lock is the contract, not the price. When you're free of
              it, talk to us. We do not lead with a cheaper bid into a locked
              house.
            </p>
          </details>
          <details>
            <summary>Is JockShock a disinfectant?</summary>
            <p>
              No. JockShock is a deodorizer for the athlete and the gear.
              ZeroPoint is the EPA-registered disinfectant for the facility.
            </p>
          </details>
          <details>
            <summary>Does ZeroPoint kill ringworm / MRSA?</summary>
            <p>
              The label covers <em>Staphylococcus aureus</em>,
              <em>Pseudomonas aeruginosa</em>, and Human Coronavirus 229E, at a
              10-minute wet dwell. We do not claim organisms that are not on
              the label.
            </p>
          </details>
          <details>
            <summary>Is this safe around kids and skin?</summary>
            <p>
              JockShock: safe on skin contact, no fragrance, no bleach.
              ZeroPoint: follow the facility label — it is a disinfectant, not
              a body spray.
            </p>
          </details>
          <details>
            <summary>Do you have wipes?</summary>
            <p>
              Body wipes (soft-pack) and gear wipes (canister) are in the
              works. Not for sale on this page.
            </p>
          </details>
          <details>
            <summary>Is there a contract?</summary>
            <p>
              No. Subscription is monthly or every other month. Pause or
              cancel. About 10% off the facility program is there to cover
              shipping.
            </p>
          </details>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { setPersona } from "../utils/persona-stamp";
  // Gym surface. Athlete checkout still works; the form is Carmen.
  setPersona("carmen");

  if (typeof window !== "undefined" && (window as any).pdPixel) {
    (window as any).pdPixel.track("gyms_lander_view", {
      sub_brand: "jockshock",
      persona: "carmen",
      surface: "gyms",
    });
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-gym-athlete-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      if ((window as any).pdPixel) {
        (window as any).pdPixel.track("gym_athlete_cta", {
          sub_brand: "jockshock",
          persona: "aaron",
          surface: "gyms",
        });
      }
    });
  });

  const form = document.querySelector<HTMLFormElement>("[data-quote-form]");
  const successPanel = document.querySelector<HTMLElement>("[data-success]");
  const submitBtn = form?.querySelector<HTMLButtonElement>(".cta-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    submitBtn.disabled = true;
    const originalLabel = submitBtn.textContent;
    submitBtn.textContent = "Sending…";

    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());

    if ((window as any).pdPixel) {
      (window as any).pdPixel.track("gym_owner_quote_requested", {
        sub_brand: "jockshock",
        persona: "carmen",
        sport: payload.sport,
        roster_size: payload.roster_size,
        under_contract: payload.under_contract,
        role: payload.role,
        jockshock_lead_source: "jockshock-gyms",
      });
    }

    try {
      const r = await fetch("/api/teams-intake", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!r.ok) throw new Error(`Server returned ${r.status}`);
      form.hidden = true;
      if (successPanel) {
        successPanel.hidden = false;
        successPanel.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    } catch (err) {
      console.error("[gyms-intake] submit failed", err);
      submitBtn.disabled = false;
      submitBtn.textContent = originalLabel;
      let errorEl = form.querySelector<HTMLElement>(".form-error");
      if (!errorEl) {
        errorEl = document.createElement("p");
        errorEl.className = "form-error";
        submitBtn.insertAdjacentElement("afterend", errorEl);
      }
      errorEl.textContent =
        "Something went wrong sending that. Email mike@southlandorganics.com and we'll handle it.";
    }
  });
</script>

<style>
  .js-gyms {
    --jockshock-black: #0a0a0a;
    --jockshock-yellow: #FFE500;
    --jockshock-text: #f3f4f6;
    --jockshock-muted: #9ca3af;
    background: var(--jockshock-black);
    color: var(--jockshock-text);
  }

  .hero-bottles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: end;
  }
  .hero-bottle {
    margin: 0;
    background: #141414;
    padding: 24px 16px 16px;
    text-align: center;
  }
  .hero-bottle img {
    width: 100%;
    max-width: 240px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .hero-bottle figcaption,
  .bottle-pair figcaption {
    color: var(--jockshock-yellow);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 12px;
  }

  .program { padding: 100px 5%; background: var(--jockshock-black); }
  .program-inner { max-width: 860px; margin: 0 auto; }

  .show { padding: 100px 5%; background: #050505; }
  .show-inner { max-width: 960px; margin: 0 auto; }
  .show .section-eyebrow { text-align: center; }
  .show-video { margin: 40px 0 0; }
  .bottle-pair {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .bottle-pair figure { margin: 0; text-align: center; background: #141414; padding: 32px 16px 20px; }
  .bottle-pair img {
    width: 100%;
    max-width: 280px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .eyebrow, .section-eyebrow, .door-eyebrow, .split-card-eyebrow, .hero-split-eyebrow {
    color: var(--jockshock-yellow);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    font-size: 0.8125rem;
    margin-bottom: 16px;
  }
