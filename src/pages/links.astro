---
import LinksLayout from "../layouts/LinksLayout.astro";
import links from "../data/links.json";

const UTM =
  "utm_source=instagram&utm_medium=organic_social&utm_campaign=link_in_bio";

function withBioUtm(href: string): string {
  const [pathAndQuery, hash] = href.split("#");
  const sep = pathAndQuery.includes("?") ? "&" : "?";
  return `${pathAndQuery}${sep}${UTM}${hash ? `#${hash}` : ""}`;
}
---

<LinksLayout
  title="Links | JockShock"
  description="Shop JockShock, parents, teams, and gyms."
>
  <main class="min-h-screen bg-carbon-black px-5 py-12">
    <div class="mx-auto w-full max-w-md text-center">
      <img
        src="/icon-512.png"
        alt={links.logoAlt}
        class="mx-auto mb-5 h-24 w-24 rounded-full border-2 border-electric-yellow bg-carbon-tint object-contain p-2"
      />
      <p class="text-sm font-bold tracking-[0.18em] text-electric-yellow uppercase">
        {links.handle}
      </p>
      <h1 class="mt-1 text-4xl text-bone">{links.name}</h1>
      <p class="mt-2 text-sm text-steel">{links.tagline}</p>

      <nav class="mt-8 flex flex-col gap-3" aria-label="Profile links">
        {
          links.links.map((link) => (
            <a
              href={withBioUtm(link.href)}
              class:list={[
                "block w-full px-5 py-3.5 text-base font-black uppercase tracking-[0.1em] transition-colors",
                link.primary
                  ? "bg-electric-yellow text-carbon-black hover:bg-yellow-200"
                  : "border-2 border-white/20 bg-carbon-tint text-bone hover:border-electric-yellow",
              ]}
              style="border-radius: 2px;"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="mt-8 flex items-center justify-center gap-5">
        {
          links.social.map((item) => (
            <a
              href={item.href}
              class="text-steel hover:text-electric-yellow"
              aria-label={item.label}
            >
              {item.platform === "instagram" ? (
                <svg
                  class="h-6 w-6"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3Z" />
                </svg>
              ) : null}
            </a>
          ))
        }
      </div>
    </div>
  </main>
</LinksLayout>
