---
/**
 * PDP accordions — shipping + returns.
 *
 * These shipped as Lorem ipsum from the Astro storefront template and were live
 * on the buy page since project init (REPLACED 2026-07-29). Copy below is not
 * written fresh — it restates the terms already published on /shipping/ and
 * /returns/, which are the pages Google Merchant Center reads.
 *
 * If a policy page changes, change it here too, or the PDP contradicts the
 * policy it links to. No placeholder text may ship on this component again.
 */
const accordions = [
  {
    title: "Shipping",
    icon: "truck",
    content:
      "Free shipping on orders of 3 bottles or more. On single bottles, shipping is calculated at checkout before you pay. Orders ship from Georgia within 1–2 business days, with tracking emailed when they leave. Standard delivery typically runs 3–6 business days via USPS or UPS. We ship to the 48 contiguous states.",
    href: "/shipping/",
    linkText: "Full shipping policy",
  },
  {
    title: "Returns",
    icon: "care",
    content:
      "30-day money-back guarantee. Return any unused, unopened product within 30 days of delivery for a refund of the purchase price to your original payment method. Return shipping is the customer's responsibility; refunds post within 5–10 business days of inspection.",
    href: "/returns/",
    linkText: "Full returns policy",
  },
];
---

<div class="grid">
  {
    accordions.map((accordion, index) => (
      <details
        class:list={[
          "group",
          "border-t",
          { "border-b": index === accordions.length - 1 },
        ]}
      >
        <summary class="flex cursor-pointer items-center justify-between py-3 px-1 font-bold text-zinc-700">
          <div class="flex items-center gap-2">
            {accordion.icon === "truck" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="h-5 w-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                />
              </svg>
            )}
            {accordion.icon === "care" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="h-5 w-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"
                />
              </svg>
            )}
            {accordion.title}
          </div>
          <span class="transition group-open:rotate-180">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-4 w-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"
              />
            </svg>
          </span>
        </summary>
        <div class="p-4 text-sm text-zinc-600">
          <p>{accordion.content}</p>
          <a
            href={accordion.href}
            class="mt-2 inline-block font-semibold text-carbon-black underline underline-offset-2"
          >
            {accordion.linkText}
          </a>
        </div>
      </details>
    ))
  }
</div>
