---
/**
 * PDP title + price block.
 *
 * The star rating, "42 Reviews" link, and "This store is for demo purposes only.
 * No orders will be fulfilled." disclaimer that shipped here from the Astro
 * storefront template were REMOVED 2026-07-29. All three were template
 * boilerplate, live on the buy page since project init, and never replaced:
 *   - the rating and review count were invented numbers (Merchant Center
 *     misrepresentation risk on a page Google crawls)
 *   - the disclaimer told every visitor their order would not be fulfilled
 *
 * Nothing here may state a review count, rating, or social-proof number until a
 * real review source is wired. Substituting different invented numbers is the
 * same defect. The trust signals below are product facts that are true today.
 */
import type { z } from "zod";
import type { MoneyV2Result } from "../utils/schemas";
import Money from "./Money.svelte";

export interface Props {
  price?: z.infer<typeof MoneyV2Result>;
  title: string;
}
const { price, title } = Astro.props as Props;
---

<h1 class="text-2xl font-bold text-carbon-black sm:text-4xl">
  {title}
</h1>
<p class="mt-4 text-3xl font-bold text-carbon-black">
  <Money price={price} />
</p>

<!-- Product-fact trust signals. Verifiable claims only — no ratings, no counts. -->
<ul class="mt-5 grid gap-2 text-sm text-zinc-700">
  <li class="flex items-start gap-2">
    <svg
      class="mt-0.5 h-4 w-4 shrink-0 text-carbon-black"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M16.704 5.29a1 1 0 010 1.414l-7.5 7.5a1 1 0 01-1.415 0l-3.5-3.5a1 1 0 111.415-1.415l2.792 2.793 6.793-6.793a1 1 0 011.415 0z"
        clip-rule="evenodd"></path>
    </svg>
    <span>Built by D1 athletes · Made in the USA</span>
  </li>
  <li class="flex items-start gap-2">
    <svg
      class="mt-0.5 h-4 w-4 shrink-0 text-carbon-black"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M16.704 5.29a1 1 0 010 1.414l-7.5 7.5a1 1 0 01-1.415 0l-3.5-3.5a1 1 0 111.415-1.415l2.792 2.793 6.793-6.793a1 1 0 011.415 0z"
        clip-rule="evenodd"></path>
    </svg>
    <span>30-day money-back guarantee</span>
  </li>
</ul>
