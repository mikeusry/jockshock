---
/**
 * Mux video player — native <video> + HLS, no external player library.
 *
 * WHY not mux-player: it's a ~100KB web component, and the LP already lost
 * Ad Rank once to mobile LCP (see c554c66, which cut 418KB of decorative
 * texture for exactly this reason). hls.js loads ONLY when a video scrolls
 * into view (or the visitor hits play).
 *
 * PLAYBACK: Chrome 147+ reports canPlayType('application/vnd.apple.mpegurl')
 * as "maybe" but native HLS then spins forever on the poster. Always prefer
 * hls.js when MSE exists; native src=m3u8 is Safari/iOS only.
 *
 * CAPTIONS: `captions` defaults ON and the track is served from Mux. Those
 * tracks were corrected on 2026-07-29 — the ASR had transcribed the spoken
 * "kills odor-causing bacteria," which is cleared for speech but banned on
 * written surfaces (a caption IS a written surface). Do not swap these back
 * to auto-generated tracks. See brand-brief.md §Claims Register.
 *
 * Poster comes from Mux's thumbnail endpoint at a fixed time so it doesn't
 * land on a motion-blurred frame.
 */
interface Props {
  playbackId: string;
  title: string;
  /** Mux text track id. Omit for videos with no captions. */
  trackId?: string;
  /** Seconds into the video to pull the poster frame from. */
  posterTime?: number;
  /** Native frame. JockShock ads are 9/16 — omitting this crops them. */
  aspect?: '16/9' | '9/16' | '1/1';
  /** Autoplay muted in-view. Use for ambient/background placements only. */
  autoplay?: boolean;
  loop?: boolean;
  class?: string;
}

const {
  playbackId,
  title,
  trackId,
  posterTime = 2,
  aspect = '16/9',
  autoplay = false,
  loop = false,
  class: className = '',
} = Astro.props;

const src = `https://stream.mux.com/${playbackId}.m3u8`;
const poster = `https://image.mux.com/${playbackId}/thumbnail.webp?time=${posterTime}`;
const captionSrc = trackId
  ? `https://stream.mux.com/${playbackId}/text/${trackId}.vtt`
  : null;
---

<div class={`mux-video ${className}`} style={`--aspect: ${aspect}`}>
  <video
    class="mux-video__el"
    data-src={src}
    data-playback-id={playbackId}
    poster={poster}
    controls={!autoplay}
    muted={autoplay ? true : undefined}
    loop={loop ? true : undefined}
    playsinline
    preload="none"
    aria-label={title}
  >
    {captionSrc && (
      <track kind="captions" src={captionSrc} srclang="en" label="English" default />
    )}
  </video>
</div>

<script>
  const players = document.querySelectorAll<HTMLVideoElement>('.mux-video__el');
  if (players.length) {
    let hlsPromise: Promise<any> | null = null;
    const loadHls = () => {
      if (!hlsPromise) {
        hlsPromise = import('hls.js');
      }
      return hlsPromise;
    };

    const pauseOthers = (event: Event) => {
      const current = event.currentTarget as HTMLVideoElement;
      for (const other of players) {
        if (other !== current && !other.paused) other.pause();
      }
    };

    const attach = async (video: HTMLVideoElement) => {
      const src = video.dataset.src;
      if (!src || video.dataset.attached) return;
      video.dataset.attached = '1';

      // Chrome 147+ returns canPlayType('mpegurl') = "maybe" then native HLS
      // spins forever. Only use native when MSE is missing (iOS Safari).
      const useNativeHls =
        Boolean(video.canPlayType('application/vnd.apple.mpegurl')) &&
        !('MediaSource' in window);

      try {
        if (!useNativeHls) {
          const mod = await loadHls();
          const Hls = mod.default ?? mod;
          if (Hls?.isSupported()) {
            const hls = new Hls({
              capLevelToPlayerSize: true,
              enableWebVTT: false,
            });
            hls.loadSource(src);
            hls.attachMedia(video);
            video.addEventListener('play', pauseOthers);
            return;
          }
        }

        if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = src;
          video.addEventListener('play', pauseOthers);
          return;
        }
      } catch {
        /* allow retry */
      }

      delete video.dataset.attached;
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            attach(e.target as HTMLVideoElement);
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '200px' }
    );

    players.forEach((p) => {
      io.observe(p);
      p.addEventListener('pointerdown', () => attach(p), { once: true });
    });
  }
</script>

<style>
  .mux-video {
    position: relative;
    width: 100%;
    aspect-ratio: var(--aspect);
    background: #000;
    overflow: hidden;
  }
  .mux-video__el {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
</style>
